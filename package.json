{
  "name": "rotalog-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "node tests/auth.test.cjs && node tests/orders-api.test.cjs && node tests/catalog-api.test.cjs && node tests/offers-api.test.cjs && node tests/inventory-api.test.cjs && node tests/supplier-products.test.cjs && node tests/supplier-stock.test.cjs && node tests/product-images.test.cjs && node tests/dashboard.test.cjs && node tests/buyer-read-api.test.cjs && node tests/buyer-api.test.cjs && node tests/order-presentation.test.cjs && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --config playwright.api.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "exceljs": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "8.2.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
