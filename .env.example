# Desenvolvimento local intencional em mock. Para usar a API, defina api.
VITE_AUTH_MODE=mock
# Obrigatória no modo api. Informe a URL real da API, sem /api/v1.
VITE_API_URL=
# Todo build exige VITE_AUTH_MODE=api e VITE_API_URL válida explícitas.
# No deploy, configure a URL HTTPS real no ambiente de build.
# Não coloque credenciais em variáveis VITE_: elas são públicas no navegador.
